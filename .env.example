# ==============================================================================
# GOPHER CRAWLER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Operating Mode: "cluster" (Go Master + Workers) or "preview" (Serverless)
OPERATING_MODE=cluster

# HTTP Server Ports
PORT=8080
MASTER_URL=http://localhost:8080

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=crawler_db
DB_SSLMODE=disable

# Redis Frontier Queue & Deduplication
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Crawler Politeness & Performance
DEFAULT_POLITENESS_MS=1000
MAX_CRAWL_DEPTH=3
MAX_PAGES_PER_JOB=250
TASK_LEASE_TIMEOUT_SEC=60
WORKER_CONCURRENCY=5

# Serverless Cloud Providers (Optional for Vercel / Cloud Preview)
# DATABASE_URL=postgres://user:password@host:5432/crawler_db?sslmode=require
# REDIS_URL=rediss://default:token@host:6379
