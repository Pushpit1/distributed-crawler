# ==============================================================================
# GOPHER CRAWLER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# HTTP Server Ports (override host ports if 8080/5433/6379 are busy on dev host)
PORT=8080
MASTER_PORT=8080
MASTER_URL=http://localhost:8080

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5433
POSTGRES_PORT=5433
DB_USER=crawler_user
DB_PASSWORD=crawler_password
DB_NAME=crawler_db
DB_SSLMODE=disable
DATABASE_URL=postgres://crawler_user:crawler_password@localhost:5433/crawler_db?sslmode=disable

# Redis Frontier Queue
REDIS_ADDR=localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=

# Crawler Politeness & Worker Concurrency
POLITENESS_MS=1000
WORKER_CONCURRENCY=2
TASK_LEASE_TIMEOUT_SEC=60

# Security & Administration Safeguards
# Leave ADMIN_API_TOKEN empty for unrestricted local dev, or set a strong secret in prod
ADMIN_API_TOKEN=
ENABLE_PRODUCTION_RESET=false
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_RPM=180

# Vercel Proxy Mode (Set on Vercel deployment to point to your live Go Coordinator)
# CRAWLER_BACKEND_URL=https://crawler-coordinator.example.com
