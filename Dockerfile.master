# Stage 1: Build statically linked Go Coordinator binary
FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o master ./cmd/master

# Stage 2: Minimal hardened runtime image
FROM alpine:latest

RUN apk --no-cache add ca-certificates wget \
    && adduser -D -u 10001 crawler

WORKDIR /app
COPY --from=builder /app/master .
COPY --from=builder /app/web ./web
RUN chown -R crawler:crawler /app

USER crawler
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["/app/master"]
