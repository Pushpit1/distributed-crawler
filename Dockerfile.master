# Stage 1: Build the Go binary statically
FROM golang:alpine AS builder

WORKDIR /app

# Copy go.mod and go.sum files and download dependencies first (allows caching modules)
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the application files
COPY . .

# Compile the Master binary statically to prevent dynamic library loading errors in thin runtimes
RUN CGO_ENABLED=0 GOOS=linux go build -o master cmd/master/main.go

# Stage 2: Final minimal runtime environment
FROM alpine:latest

# Install ca-certificates in case we connect to HTTPS seeds from the master
RUN apk --no-cache add ca-certificates

WORKDIR /app

# Copy the compiled binary and web assets from the builder stage
COPY --from=builder /app/master .
COPY --from=builder /app/web ./web

# Expose the API port
EXPOSE 8080

# Run the master executable by default
ENTRYPOINT ["/app/master"]
